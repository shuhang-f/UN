# Configure these as Railway service variables. Never commit real values.
# Use the generated Railway HTTPS origin, with no route or query.
WEB_APP_ORIGIN=https://your-service.up.railway.app
WEB_DEMO_USERNAME=un
# Generate a random password (at least 24 printable ASCII characters).
# Set the same secret in the Sites gateway as BACKEND_PASSWORD.
WEB_DEMO_PASSWORD=
UN_DATA_DIR=/data
# Attach one Railway volume at /data; Railway supplies RAILWAY_VOLUME_MOUNT_PATH.
# Railway volumes are mounted as root (see dev-docs/deployment.md).
RAILWAY_RUN_UID=0
# Optional AI tools: leave these absent for the guided sample demo.
# MODEL_PROVIDER=openai
# MODEL=gpt-5.6-sol
# OPENAI_API_KEY=
# EXA_API_KEY=
# AMBIGUOUS_API_KEY=
